<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/VERSION').Trim())</Version>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup><PackageReference Include="Npgsql" Version="10.0.0" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Database/Migrations/*.sql" /></ItemGroup>
  <ItemGroup>
    <Content Update="release.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" />
    <Content Remove="App_Data/**;.local/**;tests/**;scripts/**;.vscode/**" />
    <Compile Remove=".local/**;tests/**;scripts/**" />
    <None Remove=".local/**" />
    <None Remove="App_Data/**" />
  </ItemGroup>
  <Target Name="StampWorkingTreeState" BeforeTargets="GetAssemblyAttributes">
    <PropertyGroup><BuildWorkingTreeState>unknown</BuildWorkingTreeState></PropertyGroup>
    <Exec Condition="Exists('$(MSBuildProjectDirectory)/.git')" Command="git -C &quot;$(MSBuildProjectDirectory)&quot; status --porcelain --untracked-files=normal" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="Low" StandardErrorImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="WorkingTreeChanges" />
      <Output TaskParameter="ExitCode" PropertyName="GitStatusExitCode" />
    </Exec>
    <PropertyGroup>
      <BuildWorkingTreeState Condition="'$(GitStatusExitCode)' == '0'">clean</BuildWorkingTreeState>
      <BuildWorkingTreeState Condition="'$(GitStatusExitCode)' == '0' and '@(WorkingTreeChanges)' != ''">modified</BuildWorkingTreeState>
    </PropertyGroup>
    <ItemGroup><AssemblyMetadata Include="WorkingTreeState" Value="$(BuildWorkingTreeState)" /></ItemGroup>
  </Target>
</Project>
